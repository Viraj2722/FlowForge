<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Spring Boot parent POM.
        WHY: it acts as a curated "bill of materials" (BOM). It pins compatible
        versions for hundreds of libraries (Jackson, Hibernate, JUnit, etc.) so
        we almost never specify <version> ourselves. This avoids "dependency hell".
        We are on the current Spring Boot 4.1.x line (Spring Framework 7 baseline).
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/> <!-- always resolve the parent from the repository -->
    </parent>

    <groupId>com.flowforge</groupId>
    <artifactId>flowforge</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>FlowForge</name>
    <description>Enterprise Workflow &amp; Job Orchestration Engine</description>

    <properties>
        <!--
            Java 21 (current LTS). Records, pattern matching, virtual threads,
            and sequenced collections are all available and we will use several.
        -->
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <!--
        Testcontainers is not managed by the Spring Boot 4 BOM, so we import its own BOM
        to keep the module versions aligned without pinning each one.
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>1.20.4</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!--
            spring-boot-starter (NOT -web yet): gives us the Spring context,
            logging (Logback + SLF4J) and YAML config binding. We intentionally
            keep Phase 1 minimal - no web, no JPA. Those arrive in later phases.
            Our engine core will NOT import Spring at all; this is only so the
            app can boot and so we have a managed logging setup.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!--
            spring-boot-starter-web: embedded Tomcat + Spring MVC + Jackson. This is
            what turns FlowForge into a running HTTP service with REST controllers.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
            Spring Security: authentication + authorization. We configure a stateless,
            JWT-based filter chain (no sessions). The oauth2-resource-server starter brings
            Spring Security's JWT support (NimbusJwtEncoder/Decoder + JOSE), which we use to
            sign/verify our own HS256 tokens - cleaner than a third-party JWT lib and it
            avoids the Jackson 2/3 split in Boot 4.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            spring-boot-starter-validation: Jakarta Bean Validation (Hibernate Validator).
            Powers @Valid on request DTOs (@NotBlank, @Size, ...), so invalid input is
            rejected at the edge with a 400 before it ever reaches the service layer.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
            Actuator: production-ready endpoints (health, info, metrics). Micrometer's
            Prometheus registry exposes /actuator/prometheus for scraping. This is our
            observability surface.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
            spring-boot-starter-data-jpa: Hibernate (JPA provider) + Spring Data JPA +
            Spring ORM + transaction management. This is our path for DOMAIN WRITES
            (create workflow + steps, update execution/task state) where identity,
            cascades, dirty checking and optimistic locking pay off. Reporting reads
            still go through plain JDBC (Phase 2). Also transitively provides Jackson,
            which Hibernate uses to bind JSON columns.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!--
            spring-boot-starter-jdbc: brings in Spring JDBC (JdbcTemplate / JdbcClient),
            Spring's transaction support, and the HikariCP connection pool. We use this
            for the reporting/aggregate queries in Phase 2. (JPA arrives in Phase 3 as a
            SEPARATE starter - we intentionally keep the JDBC and JPA usage explicit.)
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!--
            PostgreSQL JDBC driver. 'runtime' scope: our code never imports driver
            classes directly (we code to the java.sql / Spring JDBC APIs); the driver is
            only needed on the classpath when the app actually runs.
        -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
            Flyway: versioned database migrations, auto-run by Spring Boot at startup.

            IMPORTANT (Spring Boot 4 change): Boot 4 split its once-monolithic
            auto-configuration into per-technology modules. As a result, adding raw
            'flyway-core' is NO LONGER enough to get auto-migration - the Flyway
            auto-configuration now lives in the 'spring-boot-starter-flyway' module.
            So we depend on the STARTER (which brings flyway-core + the autoconfig),
            plus 'flyway-database-postgresql' because since Flyway 10 each database
            family ships as its own module. Versions are managed by the Spring Boot BOM.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!--
            Test starter: JUnit 5 (Jupiter), AssertJ, Mockito, Spring Test.
            Version is managed by the parent BOM. Test-scoped only.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            Testcontainers: spins up a REAL, throwaway PostgreSQL in Docker for
            integration tests, so they don't depend on a hand-configured local DB. The
            container tests self-skip when Docker isn't available (disabledWithoutDocker).
            Versions are managed by the Spring Boot BOM.
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                Repackages the app into an executable "fat jar" and enables
                `mvn spring-boot:run`. Version managed by the parent.
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!--
                Silence the JDK's "dynamic agent loading" warning that appears because
                Spring/Mockito attach an agent at runtime during tests. This is cosmetic;
                it does not change test behaviour.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-XX:+EnableDynamicAgentLoading -Xshare:off</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
