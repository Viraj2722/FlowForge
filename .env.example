# =====================================================================
# FlowForge environment variables - EXAMPLE / TEMPLATE
#
# Copy this file to `.env` (which is git-ignored) and fill in real values,
# OR set these as environment variables in your IntelliJ run configuration.
# NEVER commit a real .env with real credentials.
#
# NOTE: Spring Boot does not read .env automatically. Use ONE of:
#   (a) IntelliJ Run Config -> Environment variables  (recommended for dev), or
#   (b) export them in your shell before `mvn spring-boot:run`, or
#   (c) your OS environment variables.
# =====================================================================

# --- PostgreSQL connection (Phase 2+) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=flowforge
DB_USERNAME=flowforge
DB_PASSWORD=REPLACE_WITH_YOUR_LOCAL_DB_PASSWORD

# --- Optional connection pool tuning ---
# DB_POOL_MAX=10
# DB_POOL_MIN=2

# --- Optional: set to DEBUG to log every SQL statement JdbcTemplate runs (dev only) ---
# SQL_LOG_LEVEL=DEBUG
